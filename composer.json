{
    "name": "wunst/wp-plugin-bauinnung-fachbetriebe-search",
    "description": "Wordpress Plugin für die Bauinnung Kiel zur Suche von Fachbetrieben nach Kategorie/Gewerk/Ort",
    "type": "project",
    "require": {
        "geocoder-php/nominatim-provider": "^5.7",
        "psr/http-client": "^1.0",
        "geocoder-php/cache-provider": "^4.4",
        "parsecsv/php-parsecsv": "^1.3",
        "spatie/guzzle-rate-limiter-middleware": "^2.1",
        "phpfastcache/phpfastcache": "^9.2"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Wunst",
            "email": "matthiesbe@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
