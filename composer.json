{
    "name": "wunst/wp-plugin-bauinnung-fachbetriebe-search",
    "description": "Wordpress Plugin für die Bauinnung Kiel zur Suche von Fachbetrieben nach Kategorie/Gewerk/Ort",
    "type": "project",
    "require": {
        "geocoder-php/nominatim-provider": "^5.7",
        "symfony/http-client": "^7.2",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "geocoder-php/cache-provider": "^4.4",
        "symfony/cache": "^7.2"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Wunst",
            "email": "ben@matthsch.de"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
      "psr-4": {
        "Fachbetrieb\\": "Functions/"
      }
    }
}
